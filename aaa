function Library:Preview(Opts)
	Opts = Opts or {}
	local Panel = Library:Panel({
		Title = Opts.Title or "esp",
		Host = Opts.Host,
		Width = Opts.Width or 284,
		Height = Opts.Height or 406,
		Position = Opts.Position,
		Icon = Opts.Icon == nil and "eye" or Opts.Icon,
		Visible = Opts.Visible,
	})

	local Area = New("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2.fromOffset(4, 10),
		Size = UDim2.new(1, -8, 1, -14),
	}, Panel.Frame)
	local Viewport = New("ViewportFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Ambient = rgb(190, 190, 190),
		LightColor = Color3.new(1, 1, 1),
	}, Area)
	local Camera = New("Camera", { CameraType = Enum.CameraType.Scriptable, FieldOfView = 48 }, Viewport)
	Viewport.CurrentCamera = Camera
	New("PointLight", { Color = Color3.new(1, 1, 1), Range = 30, Brightness = 2 }, Camera)
	local World = New("WorldModel", {}, Viewport)
	local Layer = New("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 5 }, Area)

	local Links = {
		Box = { Enabled = false },
		Fill = { Enabled = false },
		Name = { Enabled = false },
		Distance = { Enabled = false },
		Tool = { Enabled = false },
		Health = { Enabled = false },
		Armor = { Enabled = false },
	}

	function Panel:Link(Element, Data)
		local Link = Links[Element]
		if Link and type(Data) == "table" then
			for Key, Value in Data do
				Link[Key] = Value
			end
		end
		return Panel
	end

	local function IsOn(Name)
		local Link = Links[Name]
		if type(Link.Toggle) == "string" then
			return Library.Flags[Link.Toggle] == true
		end
		return Link.Enabled == true
	end

	local function ColorOf(Name, Fallback)
		local Value = Links[Name].Color
		if type(Value) == "string" then
			Value = Library.Flags[Value]
		end
		if typeof(Value) == "Color3" then
			return Value
		end
		return Fallback
	end

	local function AlphaOf(Name, Fallback)
		local Value = Links[Name].Color
		if type(Value) == "string" and Library.Alphas[Value] then
			return Library.Alphas[Value]
		end
		return Fallback
	end

	local function Stroked(Color, Thickness, ZIndex)
		local Frame = New("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = ZIndex }, Layer)
		local Stroke = New("UIStroke", { Color = Color, Thickness = Thickness, LineJoinMode = Enum.LineJoinMode.Miter }, Frame)
		return Frame, Stroke
	end

	local FillFrame = New("Frame", { BorderSizePixel = 0, ZIndex = 5 }, Layer)
	New("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }),
	}, FillFrame)
	local BoxOutline = Stroked(Color3.new(0, 0, 0), 3, 6)
	local BoxFrame, BoxStroke = Stroked(Theme.AccentB, 1, 7)

	local function Bar()
		local Outline = New("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, ZIndex = 7 }, Layer)
		local Fill = New("Frame", { BorderSizePixel = 0, ZIndex = 8 }, Outline)
		return { Outline = Outline, Fill = Fill }
	end
	local Bars = { Health = Bar(), Armor = Bar() }

	local function Caption()
		return Text({
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, 0),
			TextColor3 = Color3.new(1, 1, 1),
			TextStrokeTransparency = 0,
			ZIndex = 8,
		}, Layer)
	end
	local Captions = { Name = Caption(), Distance = Caption(), Tool = Caption() }

	local Model
	local Center = Vector3.zero
	local Distance = tonumber(Opts.Distance) or 11
	local AngleX, AngleY = 0, 0
	local Dragging = false

	function Panel:SetUser(UserId)
		task.spawn(function()
			local Created
			pcall(function()
				local Description = Players:GetHumanoidDescriptionFromUserId(UserId)
				Created = Players:CreateHumanoidModelFromDescription(Description, Enum.HumanoidRigType.R6)
			end)
			if not Created then
				pcall(function()
					Created = Players:CreateHumanoidModelFromUserId(UserId)
				end)
			end
			if not Created or Library.Unloaded then
				return
			end
			World:ClearAllChildren()
			Created.Name = "PreviewAvatar"
			Created.Parent = World
			Model = Created
			local Root = Created:FindFirstChild("HumanoidRootPart") or Created:FindFirstChild("Torso") or Created.PrimaryPart
			if Root then
				Center = Root.Position
			end
		end)
	end

	ClickArea(Area, 9).InputBegan:Connect(function(Input)
		if not IsPress(Input) then
			return
		end
		local Last = Vector2.new(Input.Position.X, Input.Position.Y)
		Dragging = true
		BeginDrag(function(Moved)
			local Current = Vector2.new(Moved.Position.X, Moved.Position.Y)
			local Delta = Current - Last
			Last = Current
			AngleX -= Delta.X * 0.015
			AngleY = math.clamp(AngleY + Delta.Y * 0.015, -math.rad(60), math.rad(60))
		end, function()
			Dragging = false
		end)
	end)

	local function Rect(Object, Left, Top, Width, Height)
		Object.Position = UDim2.fromOffset(Left, Top)
		Object.Size = UDim2.fromOffset(math.max(Width, 0), math.max(Height, 0))
	end

	local function Project(Point, Width, Height)
		local Relative = Camera.CFrame:PointToObjectSpace(Point)
		if Relative.Z >= -0.01 then
			return nil
		end
		local Focal = 1 / math.tan(math.rad(Camera.FieldOfView) / 2)
		local Half = Height / 2
		return Width / 2 + (Relative.X / -Relative.Z) * Focal * Half, Half - (Relative.Y / -Relative.Z) * Focal * Half
	end

	local function Bounds(Width, Height)
		if Model then
			local Right = Camera.CFrame.RightVector
			local Up = Vector3.yAxis
			local MinX, MinY, MaxX, MaxY = math.huge, math.huge, -math.huge, -math.huge
			for _, Point in {
				Center + Up * 2.6 + Right * 1.7,
				Center + Up * 2.6 - Right * 1.7,
				Center - Up * 3 + Right * 1.7,
				Center - Up * 3 - Right * 1.7,
			} do
				local PointX, PointY = Project(Point, Width, Height)
				if PointX then
					MinX, MinY = math.min(MinX, PointX), math.min(MinY, PointY)
					MaxX, MaxY = math.max(MaxX, PointX), math.max(MaxY, PointY)
				end
			end
			if MinX < MaxX and MinY < MaxY then
				return math.floor(MinX), math.floor(MinY), math.floor(MaxX - MinX), math.floor(MaxY - MinY)
			end
		end
		local BoxWidth = math.clamp(Width * 0.42, 80, Width * 0.55)
		local BoxHeight = math.clamp(Height * 0.6, 130, Height * 0.72)
		return math.floor((Width - BoxWidth) / 2), math.floor((Height - BoxHeight) * 0.38), math.floor(BoxWidth), math.floor(BoxHeight)
	end

	local SAMPLES = { Health = 0.72, Armor = 0.55 }

	local function Render()
		local Width, Height = Area.AbsoluteSize.X, Area.AbsoluteSize.Y
		local Left, Top, BoxWidth, BoxHeight = Bounds(Width, Height)

		local ShowBox = IsOn("Box")
		BoxOutline.Visible = ShowBox
		BoxFrame.Visible = ShowBox
		BoxStroke.Color = ColorOf("Box", Theme.AccentB)
		BoxStroke.Transparency = 1 - AlphaOf("Box", 1)
		Rect(BoxOutline, Left, Top, BoxWidth, BoxHeight)
		Rect(BoxFrame, Left, Top, BoxWidth, BoxHeight)

		local ShowFill = IsOn("Fill")
		FillFrame.Visible = ShowFill
		if ShowFill then
			FillFrame.BackgroundColor3 = ColorOf("Fill", Theme.AccentB)
			Rect(FillFrame, Left, Top, BoxWidth, BoxHeight)
		end

		local Stack = 0
		for _, Kind in { "Health", "Armor" } do
			local Entry = Bars[Kind]
			local On = IsOn(Kind)
			Entry.Outline.Visible = On
			if On then
				local Amount = SAMPLES[Kind]
				Entry.Fill.BackgroundColor3 = ColorOf(Kind, Kind == "Health" and rgb(90, 220, 110) or Theme.AccentB)
				Rect(Entry.Outline, Left - 7 - Stack * 6, Top - 1, 4, BoxHeight + 2)
				Rect(Entry.Fill, 1, 1 + math.floor(BoxHeight * (1 - Amount)), 2, math.ceil(BoxHeight * Amount))
				Stack += 1
			end
		end

		local Name = Captions.Name
		Name.Visible = IsOn("Name")
		if Name.Visible then
			Name.Text = LocalPlayer.DisplayName
			Name.TextColor3 = ColorOf("Name", Color3.new(1, 1, 1))
			Name.AnchorPoint = Vector2.new(0.5, 1)
			Name.Position = UDim2.fromOffset(math.floor(Left + BoxWidth / 2), Top - 4)
		end

		local Below = 0
		for _, Entry in { { "Distance", "[ 24m ]" }, { "Tool", "[ tool ]" } } do
			local Label = Captions[Entry[1]]
			Label.Visible = IsOn(Entry[1])
			if Label.Visible then
				Label.Text = Entry[2]
				Label.TextColor3 = ColorOf(Entry[1], Color3.new(1, 1, 1))
				Label.AnchorPoint = Vector2.new(0.5, 0)
				Label.Position = UDim2.fromOffset(math.floor(Left + BoxWidth / 2), Top + BoxHeight + 4 + Below * 13)
				Below += 1
			end
		end
	end

	Connect(RunService.RenderStepped, function(Delta)
		if not (Library.Open and Panel.Window.Visible) then
			return
		end
		if not Dragging then
			AngleX += Delta * 0.8
			AngleY *= 0.95
		end
		local CosY = math.cos(AngleY)
		local Offset = Vector3.new(math.sin(AngleX) * CosY * Distance, math.sin(AngleY) * Distance, math.cos(AngleX) * CosY * Distance)
		Camera.CFrame = CFrame.new(Center + Offset, Center)
		pcall(Render)
	end)

	Panel:SetUser(tonumber(Opts.UserId) or Library.PreviewUserId)

	Panel.Viewport = Viewport
	Library._Preview = Panel
	return Panel
end

local function DefaultArmor(Player)
	local Character = Player.Character
	local Effects = Character and Character:FindFirstChild("BodyEffects")
	local Armor = Effects and Effects:FindFirstChild("Armor")
	if Armor and Armor:IsA("ValueBase") and type(Armor.Value) == "number" then
		return Armor.Value, 130
	end
	return nil
end

