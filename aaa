local function CreateBind(Opts, Label, OnState)
	local Bind = {
		Key = Opts.Default,
		Mode = Opts.Mode or "Toggle",
		State = false,
		Name = Opts.Name or "Keybind",
	}

	local Button = New("TextButton", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 1, 0),
		FontFace = Library.Font,
		TextSize = Library.TextSize,
		TextColor3 = Theme.Dim,
		TextStrokeTransparency = 0.65,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 6,
	}, Label)

	local function Refresh()
		Button.Text = "<" .. KeyName(Bind.Key) .. ">"
		Call(Bind.Changed, Bind.Key)
		if Library._RefreshBinds then
			Library._RefreshBinds()
		end
	end

	function Bind.Apply(State)
		if Bind.Mode == "Always" then
			State = true
		end
		if Bind.State == State then
			return
		end
		Bind.State = State
		Call(OnState, State)
		if Library._RefreshBinds then
			Library._RefreshBinds()
		end
	end

	function Bind:SetKey(Key)
		Bind.Key = Key
		Refresh()
	end

	function Bind:SetMode(Mode)
		Bind.Mode = Mode
		if Mode == "Always" then
			Bind.Apply(true)
		elseif Bind.State then
			Bind.Apply(false)
		end
		Refresh()
	end

	Button.MouseButton1Click:Connect(function()
		ClosePopup()
		Button.Text = "<...>"
		local Listening = {
			Armed = false,
			Finish = function(Key)
				Bind.Key = Key
				Refresh()
			end,
		}
		Library._Listening = Listening
		task.delay(0.15, function()
			Listening.Armed = true
		end)
	end)

	Button.MouseButton2Click:Connect(function()
		local Frame, Inner = Box({
			Size = UDim2.fromOffset(62, 3 * 16 + 4),
			Position = UDim2.fromOffset(OverlayPoint(Button).X, OverlayPoint(Button).Y + Button.AbsoluteSize.Y + 2),
			ZIndex = 50,
		}, Overlay)
		for Index, Mode in { "Toggle", "Hold", "Always" } do
			local Item = New("TextButton", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(0, (Index - 1) * 16),
				Size = UDim2.new(1, 0, 0, 16),
				FontFace = Library.Font,
				TextSize = Library.TextSize,
				TextColor3 = Bind.Mode == Mode and Theme.AccentB or Theme.Dim,
				TextStrokeTransparency = 0.65,
				Text = string.lower(Mode),
				AutoButtonColor = false,
			}, Inner)
			Item.MouseButton1Click:Connect(function()
				Bind:SetMode(Mode)
				ClosePopup()
			end)
		end
		OpenPopup({
			Frame = Frame,
			Owner = Button,
			Close = function()
				Frame:Destroy()
			end,
		})
	end)

	table.insert(Library.Binds, Bind)
	Refresh()
	if Bind.Mode == "Always" then
		Bind.Apply(true)
	end

	if Opts.Flag then
		RegisterOption(Opts.Flag, {
			Save = function()
				return {
					Key = typeof(Bind.Key) == "EnumItem" and Bind.Key.Name or nil,
					Kind = typeof(Bind.Key) == "EnumItem" and tostring(Bind.Key.EnumType) or nil,
					Mode = Bind.Mode,
				}
			end,
			Load = function(Data)
				if type(Data) ~= "table" then
					return
				end
				local Key
				if type(Data.Key) == "string" then
					local Kind = Data.Kind == "UserInputType" and Enum.UserInputType or Enum.KeyCode
					pcall(function()
						Key = Kind[Data.Key]
					end)
				end
				Bind.Key = Key
				Bind:SetMode(type(Data.Mode) == "string" and Data.Mode or "Toggle")
			end,
		})
	end

	return Bind, Button
end

