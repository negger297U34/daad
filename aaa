Connect(UserInputService.InputBegan, function(Input, Processed)
	if Library.Unloaded then
		return
	end

	local Listening = Library._Listening
	if Listening then
		local Key
		if Input.UserInputType == Enum.UserInputType.Keyboard then
			if Input.KeyCode ~= Enum.KeyCode.Escape and Input.KeyCode ~= Enum.KeyCode.Backspace then
				Key = Input.KeyCode
			end
		elseif Input.UserInputType == Enum.UserInputType.MouseButton1 or Input.UserInputType == Enum.UserInputType.MouseButton2 or Input.UserInputType == Enum.UserInputType.MouseButton3 then
			if Listening.Armed then
				Key = Input.UserInputType
			else
				return
			end
		else
			return
		end
		Library._Listening = nil
		Listening.Finish(Key)
		return
	end

	if IsPress(Input) then
		Library._Dismissed = nil
		local Popup = Library._Popup
		if Popup then
			local Point = ScreenPosition(Input)
			if not Inside(Popup.Frame, Point) and not Inside(Popup.Owner, Point) then
				Library._Dismissed = Popup.Owner
				ClosePopup()
			end
		end
	end

	if UserInputService:GetFocusedTextBox() then
		return
	end

	if Input.KeyCode == Library.MenuKey and Input.UserInputType == Enum.UserInputType.Keyboard then
		Library:Toggle()
	end

	for _, Bind in Library.Binds do
		if KeyMatches(Bind.Key, Input) and not (Processed and Input.UserInputType ~= Enum.UserInputType.Keyboard and Library.Open) then
			if Bind.Mode == "Hold" then
				Bind.Apply(true)
			elseif Bind.Mode == "Toggle" then
				Bind.Apply(not Bind.State)
			end
		end
	end
end)

Connect(UserInputService.InputEnded, function(Input)
	if Library.Unloaded then
		return
	end
	for _, Bind in Library.Binds do
		if Bind.Mode == "Hold" and KeyMatches(Bind.Key, Input) then
			Bind.Apply(false)
		end
	end
end)

