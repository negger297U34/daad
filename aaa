function Library:KeybindList(Opts)
	Opts = Opts or {}
	local Panel = Opts.Section or Library:Panel({
		Title = Opts.Title or "keybinds",
		Width = Opts.Width or 190,
		Height = Opts.Height or 160,
		Position = Opts.Position or UDim2.fromOffset(12, 300),
		Icon = Opts.Icon == nil and "keyboard" or Opts.Icon,
		Visible = Opts.Visible == true,
	})
	local Rows = {}

	Library._RefreshBinds = function()
		for _, Entry in Rows do
			Entry:Destroy()
		end
		table.clear(Rows)
		for _, Bind in Library.Binds do
			if Bind.Key ~= nil or Bind.Mode == "Always" then
				local Line = New("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 12) }, Panel.Content)
				Text({ Size = UDim2.fromScale(1, 1), Text = tostring(Bind.Name), TextColor3 = Bind.State and Theme.Text or Theme.Dim }, Line)
				Text({
					Size = UDim2.fromScale(1, 1),
					Text = "<" .. KeyName(Bind.Key) .. ">",
					TextXAlignment = Enum.TextXAlignment.Right,
					TextColor3 = Bind.State and Theme.AccentB or Theme.Dim,
				}, Line)
				table.insert(Rows, Line)
			end
		end
	end
	Library._RefreshBinds()

	Library._KeybindList = Panel
	return Panel
end

