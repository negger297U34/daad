local AccentGradients = {}
local FillGradients = {}

local function AccentSequence()
	return ColorSequence.new(Theme.AccentA, Theme.AccentB)
end

local function FillSequence()
	return ColorSequence.new(Theme.AccentB:Lerp(Color3.new(1, 1, 1), 0.22), Theme.AccentB:Lerp(Color3.new(0, 0, 0), 0.12))
end

local function AccentGradient(Parent, Rotation)
	local Gradient = New("UIGradient", { Color = AccentSequence(), Rotation = Rotation or 0 }, Parent)
	table.insert(AccentGradients, Gradient)
	return Gradient
end

local function FillGradient(Parent)
	local Gradient = New("UIGradient", { Color = FillSequence(), Rotation = 90 }, Parent)
	table.insert(FillGradients, Gradient)
	return Gradient
end

local function RefreshGradients(List, Sequence)
	for Index = #List, 1, -1 do
		local Gradient = List[Index]
		if Gradient.Parent then
			Gradient.Color = Sequence
		else
			table.remove(List, Index)
		end
	end
end

local function StrokeColor()
	local Back = Theme.Background
	local Light = 0.299 * Back.R + 0.587 * Back.G + 0.114 * Back.B > 0.6
	return Light and Color3.new(1, 1, 1) or Color3.new(0, 0, 0)
end

local function PaintStroke(Object)
	if Object:IsA("TextLabel") or Object:IsA("TextButton") or Object:IsA("TextBox") then
		Object.TextStrokeColor3 = StrokeColor()
	end
end

for _, Root in { Gui, Overlay, NotifyGui } do
	Root.DescendantAdded:Connect(PaintStroke)
end

local function ApplyTheme(Changes)
	local Map = {}
	for Key, Value in Changes do
		local Old = Theme[Key]
		if typeof(Value) == "Color3" and typeof(Old) == "Color3" then
			if Key ~= "AccentA" and Old ~= Value then
				table.insert(Map, { Old, Value })
			end
			Theme[Key] = Value
		end
	end

	local function Remap(Object, Property)
		local Current = Object[Property]
		for _, Pair in Map do
			if Current == Pair[1] then
				Object[Property] = Pair[2]
				return
			end
		end
	end

	if #Map > 0 then
		for _, Root in { Gui, Overlay, NotifyGui } do
			for _, Object in Root:GetDescendants() do
				if not Object:GetAttribute("NoTheme") then
					if Object:IsA("GuiObject") then
						Remap(Object, "BackgroundColor3")
						if Object:IsA("TextLabel") or Object:IsA("TextButton") then
							Remap(Object, "TextColor3")
						elseif Object:IsA("TextBox") then
							Remap(Object, "TextColor3")
							Remap(Object, "PlaceholderColor3")
						elseif Object:IsA("ImageLabel") then
							Remap(Object, "ImageColor3")
						elseif Object:IsA("ScrollingFrame") then
							Remap(Object, "ScrollBarImageColor3")
						end
					elseif Object:IsA("UIStroke") then
						Remap(Object, "Color")
					end
				end
			end
		end
	end

	for _, Root in { Gui, Overlay, NotifyGui } do
		for _, Object in Root:GetDescendants() do
			PaintStroke(Object)
		end
	end

	RefreshGradients(AccentGradients, AccentSequence())
	RefreshGradients(FillGradients, FillSequence())
	if Library._AccentChanged then
		Library._AccentChanged()
	end
end

function Library:SetAccent(First, Second)
	local Changes = {}
	if typeof(First) == "Color3" then
		Changes.AccentA = First
	end
	if typeof(Second) == "Color3" then
		Changes.AccentB = Second
	end
	ApplyTheme(Changes)
end

function Library:SetTheme(Name)
	local Preset = Library.Themes[Name]
	if not Preset then
		return false
	end
	Library.ThemeName = Name
	ApplyTheme(Preset)
	for _, Listener in Library._ThemeListeners do
		Call(Listener, Name)
	end
	pcall(function()
		if writefile and isfolder and makefolder then
			if not isfolder(Library.Directory) then
				makefolder(Library.Directory)
			end
			writefile(Library.Directory .. "/theme.txt", Name)
		end
	end)
	return true
end

