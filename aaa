local WindowOrder = 0
local Layout = { X = 24, Y = 60, Start = 24, Row = 0, Count = 0 }

local function AutoPlace(Width, Height, Bounds)
	if Layout.Count > 0 and Layout.X > Layout.Start and Layout.X + Width > Bounds.X - 8 then
		Layout.X = Layout.Start
		Layout.Y += Layout.Row + 10
		Layout.Row = 0
	end
	local Left, Top = Layout.X, Layout.Y
	Layout.X += Width + 10
	Layout.Row = math.max(Layout.Row, Height)
	Layout.Count += 1
	if Layout.Count == 1 then
		Layout.Start = Layout.X
		Layout.Row = 0
	end
	if Left + Width > Bounds.X - 8 then
		Left = math.max(Bounds.X - Width - 8, 8)
	end
	if Top + Height > Bounds.Y - 8 then
		Top = math.max(Bounds.Y - Height - 8, 8)
	end
	return UDim2.fromOffset(math.floor(Left), math.floor(Top))
end

