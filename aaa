		local Black = New("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), ZIndex = 2 }, Map)
		New("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90 }, Black)
		local Cursor = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 1,
			Size = UDim2.fromOffset(4, 4),
			ZIndex = 3,
		}, Map)
		New("UICorner", { CornerRadius = UDim.new(1, 0) }, Cursor)
		New("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1 }, Cursor)

		local HueOuter, HueBar = Box({ Size = UDim2.fromOffset(14, 140), Position = UDim2.fromOffset(158, 10) }, ColorPage, Color3.new(1, 1, 1))
		New("UIGradient", { Color = HueSequence(), Rotation = 90 }, HueBar)
		local HueCursor = New("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 1,
			Size = UDim2.new(1, 0, 0, 2),
			ZIndex = 3,
		}, HueBar)

		local AlphaOuter, AlphaBar = Box({ Size = UDim2.fromOffset(162, 14), Position = UDim2.fromOffset(10, 158) }, ColorPage, Color3.new(1, 1, 1))
		local AlphaGradient = New("UIGradient", { Color = ColorSequence.new(Theme.Element, Color) }, AlphaBar)
		local AlphaCursor = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderColor3 = Color3.new(0, 0, 0),
			BorderSizePixel = 1,
			Size = UDim2.new(0, 2, 1, 0),
			ZIndex = 3,
		}, AlphaBar)

		local function Field(Left, Top, FieldWidth)
			local _, FieldInner = Box({ Position = UDim2.fromOffset(Left, Top), Size = UDim2.fromOffset(FieldWidth, 18) }, ColorPage)
			return New("TextBox", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Size = UDim2.new(1, -8, 1, 0),
				Position = UDim2.fromOffset(4, 0),
				FontFace = Library.Font,
				TextSize = Library.TextSize,
				TextColor3 = Theme.Text,
				TextStrokeTransparency = 0.65,
				TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false,
				Text = "",
			}, FieldInner)
		end

		local Channels = { Field(10, 180, 51), Field(65, 180, 52), Field(121, 180, 51) }
		local Hex = Field(10, 202, 162)

		PopupRefresh = function()
			Map.BackgroundColor3 = Color3.fromHSV(Hue, 1, 1)
			Cursor.Position = UDim2.fromScale(Saturation, 1 - Value)
			HueCursor.Position = UDim2.fromScale(0, Hue)
			AlphaCursor.Position = UDim2.fromScale(Alpha, 0)
			AlphaGradient.Color = ColorSequence.new(Theme.Element, Color)
			local Parts = { Color.R, Color.G, Color.B }
			for Index, Channel in Channels do
				if not Channel:IsFocused() then
					Channel.Text = tostring(math.floor(Parts[Index] * 255 + 0.5))
				end
			end
			if not Hex:IsFocused() then
				Hex.Text = "#" .. string.upper(Color:ToHex())
			end
		end
		PopupRefresh()

		local function Track(Area, Update)
			ClickArea(Area, 8).InputBegan:Connect(function(Input)
				if not IsPress(Input) then
					return
				end
				local function Move(Current)
					local Point = ScreenPosition(Current)
					local Position, Size = Area.AbsolutePosition, Area.AbsoluteSize
					Update(math.clamp((Point.X - Position.X) / Size.X, 0, 1), math.clamp((Point.Y - Position.Y) / Size.Y, 0, 1))
					Apply(false)
				end
				Move(Input)
				BeginDrag(Move)
			end)
		end

		Track(Map, function(MapX, MapY)
			Saturation = MapX
			Value = 1 - MapY
		end)
		Track(HueBar, function(_, MapY)
			Hue = MapY
		end)
		Track(AlphaBar, function(MapX)
			Alpha = MapX
		end)

		for Index, Channel in Channels do
			Channel.FocusLost:Connect(function()
				local Parts = { Color.R * 255, Color.G * 255, Color.B * 255 }
				local Number = tonumber(Channel.Text)
				if Number then
					Parts[Index] = math.clamp(Number, 0, 255)
					Hue, Saturation, Value = rgb(Parts[1], Parts[2], Parts[3]):ToHSV()
