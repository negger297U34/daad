	local NameLabel = Text({
		Size = UDim2.new(1, 0, 0, 14),
		Text = "no player selected",
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, Details)
	local CopyButton = New("TextButton", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, 0), Size = UDim2.new(1, 0, 0, 14), Text = "", AutoButtonColor = false, ZIndex = 3 }, Details)
	CopyButton.MouseButton1Click:Connect(function()
		if not Selected then
			return
		end
		pcall(setclipboard, string.format("%s / %s / %d", Selected.DisplayName, Selected.Name, Selected.UserId))
		Library:Notify("copied", 2)
	end)
	local DisplayLabel = Text({ Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd }, Details)
	local StatusLabel = Text({ Position = UDim2.fromOffset(0, 16), Size = UDim2.new(1, 0, 0, 14), TextColor3 = Theme.Dim }, Details)
	Panel.Status = StatusLabel
	local ArmorLabel = Text({
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 0, 12),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
		Visible = false,
	}, Details)
	local ArmorOuter, ArmorInner = Box({ Position = UDim2.fromOffset(0, 48), Size = UDim2.new(1, 0, 0, 12), Visible = false }, Details)
	local ArmorFill = New("Frame", { BackgroundColor3 = rgb(152, 188, 255), BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, ArmorInner)
	ArmorFill:SetAttribute("NoTheme", true)
	local HealthLabel = Text({
		Position = UDim2.fromOffset(0, 62),
		Size = UDim2.new(1, 0, 0, 12),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
	}, Details)
	local HealthOuter, HealthInner = Box({ Position = UDim2.fromOffset(0, 77), Size = UDim2.new(1, 0, 0, 12) }, Details)
	local HealthFill = New("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, HealthInner)
	FillGradient(HealthFill)

	local function ActionRow(Offset)
		return New("Frame", {
			AnchorPoint = Vector2.new(0, 1),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.new(0, 10, 1, Offset),
			Size = UDim2.new(1, -20, 0, 22),
		}, Root)
	end
	local FRIEND = rgb(110, 220, 140)
	local Items = {}
	local Tags = {}
	local FriendLabel
	local Paint
	local function BuildActions(Holder, Names)
		for Index, Name in Names do
			local Outer, Inner = Box({
				Position = UDim2.new((Index - 1) / #Names, 0, 0, 0),
				Size = UDim2.new(1 / #Names, Index < #Names and -3 or 0, 1, 0),
			}, Holder)
			local Label = Text({ Size = UDim2.fromScale(1, 1), Text = Name, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = Theme.Dim }, Inner)
			Panel.ActionLabels[Name] = Label
			if Name == "friend" then
				FriendLabel = Label
			end
			local Click = ClickArea(Outer, 5)
			Click.MouseEnter:Connect(function()
				Label.TextColor3 = Theme.Text
			end)
			Click.MouseLeave:Connect(function()
				Label.TextColor3 = Theme.Dim
			end)
			Click.MouseButton1Click:Connect(function()
				if not Selected then
					return
				end
				local Action = Name
				if Name == "friend" then
					Library.Friends[Selected.UserId] = not Library.Friends[Selected.UserId] or nil
					Action = Library.Friends[Selected.UserId] and "friend" or "unfriend"
					Paint()
				end
				Call(Opts.Callback, Action, Selected)
			end)
			Click.MouseButton2Click:Connect(function()
				if Selected then
					Call(Opts.Callback, Name .. "_right", Selected)
				end
			end)
		end
	end

	BuildActions(ActionRow(-8 - Shift), Opts.Actions or { "friend", "spectate", "teleport", "target" })
	if Opts.ExtraActions then
		BuildActions(ActionRow(-8), Opts.ExtraActions)
	end

	Paint = function()
		for Player, Item in Items do
			local Friended = Library.Friends[Player.UserId] == true
			Item.Name = (Friended and "0_" or "1_") .. string.lower(Player.Name)
			Item.TextColor3 = Player == Selected and Theme.AccentB or (Friended and FRIEND or Theme.Dim)
			Item.TextStrokeTransparency = Player == Selected and 0.2 or 0.65
			Tags[Player].Visible = Friended
		end
		if FriendLabel then
			FriendLabel.Text = (Selected and Library.Friends[Selected.UserId]) and "unfriend" or "friend"
		end
	end

	local function Select(Player)
		Selected = Player
		Avatar.Image = Player and string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", Player.UserId) or ""
		Paint()
	end

	local function Add(Player)
		if Player == LocalPlayer or Items[Player] then
			return
		end
		local Item = New("TextButton", {
			Name = string.lower(Player.Name),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.new(1, 0, 0, 28),
			FontFace = Library.Font,
			TextSize = Library.TextSize,
			TextColor3 = Theme.Dim,
			TextStrokeTransparency = 0.65,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Text = Player.DisplayName,
			AutoButtonColor = false,
		}, Scroll)
		New("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, Item)
		local Tag = Text({
			Size = UDim2.fromScale(1, 1),
			Text = "friend",
			TextColor3 = FRIEND,
			TextXAlignment = Enum.TextXAlignment.Right,
			Visible = false,
		}, Item)
		Tag:SetAttribute("NoTheme", true)
		Items[Player] = Item
		Tags[Player] = Tag
		Item.MouseButton1Click:Connect(function()
			Select(Player)
		end)
		Paint()
	end

	for _, Player in Players:GetPlayers() do
		Add(Player)
	end
	Connect(Players.PlayerAdded, Add)
	Connect(Players.PlayerRemoving, function(Player)
		if Items[Player] then
			Items[Player]:Destroy()
			Items[Player] = nil
			Tags[Player] = nil
		end
		if Selected == Player then
			Select(nil)
		end
	end)

	local nextPlayerlistUpdate = 0
	Connect(RunService.Heartbeat, function()
		if not (Library.Open and Panel.Window.Visible) then
			return
		end
		if os.clock() < nextPlayerlistUpdate then
			return
		end
		nextPlayerlistUpdate = os.clock() + 0.1
		if not Selected then
			NameLabel.Text = "no player selected"
			DisplayLabel.Text = ""
			StatusLabel.Text = ""
			HealthLabel.Text = ""
			HealthFill.Size = UDim2.fromScale(0, 1)
			ArmorLabel.Visible = false
			ArmorOuter.Visible = false
			return
		end
		local Character = Selected.Character
		local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
		local Health = Humanoid and Humanoid.Health or 0
		local MaxHealth = Humanoid and math.max(Humanoid.MaxHealth, 1) or 100
		NameLabel.Text = string.format("%s (@%s)", Selected.DisplayName, Selected.Name)
		DisplayLabel.Text = ""

		local Status = Selected == LocalPlayer and "you" or (Library.Friends[Selected.UserId] and "friend" or "enemy")
		local Mine = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
		local Theirs = Character and Character:FindFirstChild("HumanoidRootPart")
		if Mine and Theirs then
			StatusLabel.Text = string.format("%.1fm   %s", (Mine.Position - Theirs.Position).Magnitude * 0.28, Status)
		else
			StatusLabel.Text = Status
		end
		StatusLabel.TextColor3 = Status == "friend" and FRIEND or Theme.Dim


		HealthFill.Size = UDim2.fromScale(math.clamp(Health / MaxHealth, 0, 1), 1)
		HealthLabel.Text = math.floor(Health + 0.5) .. "/" .. math.floor(MaxHealth + 0.5)

		local Ok, Armor, MaxArmor = pcall(GetArmor, Selected)
		local HasArmor = Ok and type(Armor) == "number"
		ArmorLabel.Visible = HasArmor
		ArmorOuter.Visible = HasArmor
		if HasArmor then
			MaxArmor = math.max(tonumber(MaxArmor) or 100, 1)
			ArmorFill.Size = UDim2.fromScale(math.clamp(Armor / MaxArmor, 0, 1), 1)
			ArmorLabel.Text = math.floor(Armor + 0.5) .. "/" .. math.floor(MaxArmor + 0.5)
		end
	end)

	function Panel:GetSelected()
		return Selected
	end

	function Panel:Select(Player)
		Select(Player)
	end

	Library._Playerlist = Panel
	return Panel
end

local ConfigViews = {}

local function ConfigNames()
	local Names = {}
	local Folder = Library.Directory .. "/Configs"
	if listfiles and isfolder and isfolder(Folder) then
		local Ok, Files = pcall(listfiles, Folder)
		if Ok and type(Files) == "table" then
			for _, File in Files do
				local Name = string.match(tostring(File), "([^/\\]+)%.json$")
				if Name then
					table.insert(Names, Name)
				end
			end
		end
	end
	table.sort(Names)
	return Names
end

function Library:RefreshConfigs()
	local Names = ConfigNames()
	for _, View in ConfigViews do
		View:SetOptions(Names)
	end
end

function Library:ConfigSection(Target, Opts)
	Opts = Opts or {}
	local NameBox
	local List = Target:List({
		Name = "Configs",
		Height = Opts.Height or 280,
		Callback = function(Name)
			if NameBox then
				NameBox:Set(Name)
			end
		end,
	})
	NameBox = Target:Textbox({ Name = "Config Name" })

	local function Report(Action, Ok, Err)
		Library:Notify(Ok and ("config " .. Action) or (Action .. " failed: " .. tostring(Err)), 3)
	end

	Target:Button({
		Name = "Save",
		Callback = function()
			local Ok, Err = Library:SaveConfig(NameBox:Get())
			Report("saved", Ok, Err)
			Library:RefreshConfigs()
		end,
	}):Button({
		Name = "Delete",
		Callback = function()
			local Ok, Err = Library:DeleteConfig(NameBox:Get())
			Report("deleted", Ok, Err)
			Library:RefreshConfigs()
		end,
	})
	Target:Button({
		Name = "Refresh",
		Callback = function()
			Library:RefreshConfigs()
		end,
	}):Button({
		Name = "Load",
		Callback = function()
			local Ok, Err = Library:LoadConfig(NameBox:Get())
			Report("loaded", Ok, Err)
		end,
	})

	table.insert(ConfigViews, List)
	List:SetOptions(ConfigNames())
	return List
end

function Library:ThemeSection(Target)
	local Dropdown = Target:Dropdown({
		Name = "Theme",
		Options = Library.ThemeNames,
		Default = Library.ThemeName,
		Search = true,
		Callback = function(Name)
			if Name ~= Library.ThemeName then
				Library:SetTheme(Name)
			end
		end,
	})
	table.insert(Library._ThemeListeners, function(Name)
		if Dropdown:Get() ~= Name then
			Dropdown:Set(Name)
		end
	end)
	return Dropdown
end

