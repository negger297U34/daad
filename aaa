local function HueSequence()
	local Points = {}
	for Index = 0, 6 do
		table.insert(Points, ColorSequenceKeypoint.new(Index / 6, Color3.fromHSV(Index / 6, 1, 1)))
	end
	return ColorSequence.new(Points)
end

local Animated = {}

Connect(RunService.Heartbeat, function()
	local Now = os.clock()
	for Swatch in Animated do
		Swatch._Step(Now)
	end
end)

local function CreateSwatch(Parent, Opts)
	Opts = Opts or {}
	local Color = typeof(Opts.Default) == "Color3" and Opts.Default or Color3.new(1, 1, 1)
	local Alpha = math.clamp(tonumber(Opts.Alpha) or 1, 0, 1)
	local Hue, Saturation, Value = Color:ToHSV()
	local Flag = Opts.Flag
	local Listeners = {}
	local Swatch = { Type = "Colorpicker" }
	local Seed = math.random() * 100
	local Page = "Color"
	local Settings = {
		Rainbow = false,
		RainbowSpeed = 1,
		Transparency = false,
		TransparencySpeed = 1,
		Shade = false,
		ShadeSpeed = 1,
	}

	local Outer, Inner = Box({ Size = UDim2.fromOffset(24, 12) }, Parent, rgb(196, 196, 196))
	Inner:SetAttribute("NoTheme", true)
	Inner.ClipsDescendants = true
	for Column = 0, 4 do
		for Line = 0, 1 do
			if (Column + Line) % 2 == 1 then
				New("Frame", {
					BackgroundColor3 = rgb(128, 128, 128),
					BorderSizePixel = 0,
					Position = UDim2.fromOffset(Column * 4, Line * 4),
					Size = UDim2.fromOffset(4, 4),
				}, Inner):SetAttribute("NoTheme", true)
			end
		end
	end
	local Paint = New("Frame", {
		BackgroundColor3 = Color,
		BackgroundTransparency = 1 - Alpha,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 2,
	}, Inner)
	Paint:SetAttribute("NoTheme", true)
	New("UIGradient", { Color = ColorSequence.new(Color3.new(1, 1, 1), rgb(214, 214, 214)), Rotation = 90 }, Paint)
	local Button = ClickArea(Outer, 6)

	if Flag then
		Library.Flags[Flag] = Color
		Library.Alphas[Flag] = Alpha
	end

	local PopupRefresh

	local function Apply(Silent)
		Color = Color3.fromHSV(Hue, Saturation, Value)
		Paint.BackgroundColor3 = Color
		Paint.BackgroundTransparency = 1 - Alpha
		if Flag then
			Library.Flags[Flag] = Color
			Library.Alphas[Flag] = Alpha
		end
		if PopupRefresh then
			PopupRefresh()
		end
		if not Silent then
			Call(Opts.Callback, Color, Alpha)
			for _, Listener in Listeners do
				Call(Listener, Color, Alpha)
			end
		end
	end

	local function Sync()
		if Settings.Rainbow or Settings.Transparency or Settings.Shade then
			Animated[Swatch] = true
		else
			Animated[Swatch] = nil
		end
	end

	Swatch._Step = function(Now)
		if not Outer.Parent then
			Animated[Swatch] = nil
			return
		end
		if Settings.Rainbow then
			Hue = (Now * Settings.RainbowSpeed * 0.15) % 1
			if Saturation < 0.05 then
				Saturation = 1
			end
		end
		if Settings.Transparency then
			Alpha = 0.5 + 0.5 * math.sin(Now * Settings.TransparencySpeed * 2)
		end
		if Settings.Shade then
			Value = math.clamp(0.65 + 0.7 * math.noise(Now * Settings.ShadeSpeed, Seed), 0.2, 1)
		end
		Apply(false)
	end

	function Swatch:Get()
		return Color, Alpha
	end

	function Swatch:Set(NewColor, NewAlpha)
		if typeof(NewColor) == "Color3" then
			Hue, Saturation, Value = NewColor:ToHSV()
		end
		if tonumber(NewAlpha) then
			Alpha = math.clamp(NewAlpha, 0, 1)
		end
		Apply(false)
	end

	function Swatch:OnChange(Listener)
		table.insert(Listeners, Listener)
	end

	local function Open()
		local Origin = OverlayPoint(Outer)
		local Camera = workspace.CurrentCamera
		local Bounds = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
		local Width, Height = 186, 256
