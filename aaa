function Section:Toggle(Opts)
	Opts = Opts or {}
	local Flag = Opts.Flag
	local State = Opts.Default == true
	local Listeners = {}
	local Toggle = { Type = "Toggle" }

	local Line = Row(self, 14)
	local Outer, Inner = Box({ Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(0, 1) }, Line)
	local Fill = New("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = State }, Inner)
	if typeof(Opts.Color) == "Color3" then
		Fill.BackgroundColor3 = Opts.Color
	else
		FillGradient(Fill)
	end
	local Label = Text({
		Position = UDim2.fromOffset(18, 0),
		Size = UDim2.new(1, -18, 1, 0),
		Text = tostring(Opts.Name or "Toggle"),
		TextColor3 = Opts.Risky and Theme.Risky or (State and Theme.Text or Theme.Dim),
	}, Line)
	local Button = ClickArea(Line, 4)
	local Holder = Addons(Line)

	if Flag then
		Library.Flags[Flag] = State
	end

	local function Apply(NewState, Silent)
		State = NewState == true
		Fill.Visible = State
		if not Opts.Risky then
			Label.TextColor3 = State and Theme.Text or Theme.Dim
		end
		if Flag then
			Library.Flags[Flag] = State
		end
		if not Silent then
			Call(Opts.Callback, State)
			for _, Listener in Listeners do
				Call(Listener, State)
			end
		end
	end

	function Toggle:Get()
		return State
	end

	function Toggle:Set(NewState)
		Apply(NewState, false)
	end

	function Toggle:OnChange(Listener)
		table.insert(Listeners, Listener)
	end

	function Toggle:AddColorpicker(ColorOpts)
		local Swatch, Frame = CreateSwatch(Holder, ColorOpts)
		Toggle._Count = (Toggle._Count or 0) + 1
		Frame.LayoutOrder = Toggle._Count
		Toggle.Colorpickers = Toggle.Colorpickers or {}
		table.insert(Toggle.Colorpickers, Swatch)
		return Toggle
	end

	function Toggle:AddKeybind(BindOpts)
		BindOpts = BindOpts or {}
		BindOpts.Name = BindOpts.Name or Opts.Name
		local Bind, BindButton = CreateBind(BindOpts, Holder, function(Active)
			Apply(Active, false)
		end)
		BindButton.LayoutOrder = 100
		Toggle.Keybind = Bind
		return Toggle
	end

	Button.MouseButton1Click:Connect(function()
		Apply(not State, false)
	end)

	RegisterOption(Flag, {
		Save = function()
			return State
		end,
		Load = function(Data)
			Apply(Data == true, false)
		end,
	})

	return Toggle
end

function Section:Slider(Opts)
	Opts = Opts or {}
	local Flag = Opts.Flag
	local Min = tonumber(Opts.Min) or 0
	local Max = tonumber(Opts.Max) or 100
	local Decimals = tonumber(Opts.Decimals) or 0
	local Step = tonumber(Opts.Step) or (10 ^ -Decimals)
	local Suffix = tostring(Opts.Suffix or "")
	local Range = Opts.Range == true
	local Low, High
	local Active = "High"
	local Slider = { Type = "Slider" }

	if Range then
		local Default = type(Opts.Default) == "table" and Opts.Default or { Min, Max }
		Low = math.clamp(tonumber(Default[1]) or Min, Min, Max)
		High = math.clamp(tonumber(Default[2]) or Max, Low, Max)
	else
		Low = Min
		High = math.clamp(tonumber(Opts.Default) or Min, Min, Max)
	end

	local Line = Row(self, 34)
	Text({ Size = UDim2.new(1, 0, 0, 12), Text = tostring(Opts.Name or "Slider"), TextColor3 = Theme.Dim }, Line)

	local Minus = New("TextButton", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(0, 14),
		Size = UDim2.fromOffset(8, 10),
		FontFace = Library.Font,
		TextSize = Library.TextSize,
		TextColor3 = Theme.Dim,
		Text = "-",
		AutoButtonColor = false,
	}, Line)
	local Plus = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.new(1, 0, 0, 14),
		Size = UDim2.fromOffset(8, 10),
		FontFace = Library.Font,
		TextSize = Library.TextSize,
		TextColor3 = Theme.Dim,
		Text = "+",
		AutoButtonColor = false,
	}, Line)

	local Outer, Inner = Box({ Position = UDim2.fromOffset(10, 14), Size = UDim2.new(1, -22, 0, 10) }, Line)
	local Fill = New("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.fromScale(0, 1) }, Inner)
	FillGradient(Fill)
	local ValueLabel = Text({
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromOffset(80, 12),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0,
		ZIndex = 3,
	}, Line)

	local function Snap(Value)
		Value = math.clamp(Value, Min, Max)
		Value = Min + math.floor((Value - Min) / Step + 0.5) * Step
		return math.clamp(Round(Value, Decimals), Min, Max)
	end

	local function Current()
		if Range then
			return { Low, High }
		end
		return High
	end

	local function Render()
		local Span = math.max(Max - Min, 1e-6)
		local From = (Low - Min) / Span
		local To = (High - Min) / Span
		Fill.Position = UDim2.fromScale(From, 0)
		Fill.Size = UDim2.fromScale(To - From, 1)
		if Range then
			ValueLabel.Text = Format(Low, Decimals) .. " - " .. Format(High, Decimals) .. Suffix
			ValueLabel.Position = UDim2.new((From + To) / 2, 10 - 22 * (From + To) / 2, 0, 19)
		else
			ValueLabel.Text = Format(High, Decimals) .. Suffix
			ValueLabel.Position = UDim2.new(To, 10 - 22 * To, 0, 19)
		end
		if Flag then
			Library.Flags[Flag] = Current()
		end
	end

	local function Commit()
		Render()
		Call(Opts.Callback, Current())
	end

	function Slider:Get()
		return Current()
	end

	function Slider:Set(Value)
		if Range and type(Value) == "table" then
			Low = Snap(tonumber(Value[1]) or Low)
			High = math.max(Snap(tonumber(Value[2]) or High), Low)
		elseif tonumber(Value) then
			High = Snap(tonumber(Value))
			if Range then
				High = math.max(High, Low)
			end
		end
		Commit()
	end

	local function FromInput(Input, Choose)
		local Point = ScreenPosition(Input)
		local Position, Size = Inner.AbsolutePosition, Inner.AbsoluteSize
		local Value = Snap(Min + (Max - Min) * math.clamp((Point.X - Position.X) / Size.X, 0, 1))
		if Range then
			if Choose then
				Active = math.abs(Value - Low) < math.abs(Value - High) and "Low" or "High"
			end
			if Active == "Low" then
				Low = math.min(Value, High)
			else
				High = math.max(Value, Low)
			end
		else
			High = Value
		end
		Commit()
	end

	ClickArea(Outer, 5).InputBegan:Connect(function(Input)
		if not IsPress(Input) then
			return
		end
		FromInput(Input, true)
		BeginDrag(function(Moved)
			FromInput(Moved, false)
		end)
	end)

	local function Nudge(Direction)
		if Range and Active == "Low" then
			Low = math.min(Snap(Low + Step * Direction), High)
		else
			High = Snap(High + Step * Direction)
			if Range then
				High = math.max(High, Low)
			end
		end
		Commit()
	end

	Minus.MouseButton1Click:Connect(function()
		Nudge(-1)
	end)
	Plus.MouseButton1Click:Connect(function()
		Nudge(1)
	end)

	Render()

	RegisterOption(Flag, {
		Save = Current,
		Load = function(Data)
			Slider:Set(Data)
		end,
	})

	return Slider
end

function Section:Dropdown(Opts)
	Opts = Opts or {}
	local Flag = Opts.Flag
	local Multi = Opts.Multi == true
	local Options = type(Opts.Options) == "table" and Opts.Options or {}
	local Selected = {}
	local Single = nil
	local Dropdown = { Type = "Dropdown" }

	if Multi then
		if type(Opts.Default) == "table" then
			for _, Name in Opts.Default do
				Selected[tostring(Name)] = true
			end
		elseif Opts.Default ~= nil then
			Selected[tostring(Opts.Default)] = true
		end
	else
		Single = Opts.Default ~= nil and tostring(Opts.Default) or (Options[1] and tostring(Options[1])) or ""
	end

	local Line = Row(self, 34)
	Text({ Size = UDim2.new(1, 0, 0, 12), Text = tostring(Opts.Name or "Dropdown"), TextColor3 = Theme.Dim }, Line)
	local Outer, Inner = Box({ Position = UDim2.fromOffset(0, 15), Size = UDim2.new(1, -18, 0, 18) }, Line)
	local Display = Text({ Position = UDim2.fromOffset(5, 0), Size = UDim2.new(1, -10, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd }, Inner)
	local PlusOuter, PlusInner = Box({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 15), Size = UDim2.fromOffset(16, 18) }, Line)
	local PlusLabel = Text({ Size = UDim2.fromScale(1, 1), Position = UDim2.fromOffset(0, -1), Text = "+", TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, TextColor3 = Theme.Dim }, PlusInner)
	PlusLabel.TextTransparency = 1
	local PlusBar = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(7, 1), BackgroundColor3 = Theme.Dim, BorderSizePixel = 0 }, PlusInner)
	local PlusStem = New("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1, 7), BackgroundColor3 = Theme.Dim, BorderSizePixel = 0 }, PlusInner)
	local Button = ClickArea(Line, 5)
	Button.Position = UDim2.fromOffset(0, 15)
	Button.Size = UDim2.new(1, 0, 0, 18)

	local function Current()
		if Multi then
			local Copy = {}
			for Name, On in Selected do
				if On then
					Copy[Name] = true
				end
			end
			return Copy
		end
		return Single
	end

	local function Render()
		if Multi then
			local Names = {}
			for _, Name in Options do
				if Selected[tostring(Name)] then
					table.insert(Names, tostring(Name))
				end
			end
			Display.Text = #Names > 0 and table.concat(Names, ", ") or "none"
		else
			Display.Text = Single
		end
		if Flag then
			Library.Flags[Flag] = Current()
		end
	end

	local function Commit()
		Render()
		Call(Opts.Callback, Current())
	end

	function Dropdown:Get()
		return Current()
	end

	function Dropdown:Set(Value)
		if Multi then
			Selected = {}
			if type(Value) == "table" then
				for Key, Item in Value do
					if Item == true then
						Selected[tostring(Key)] = true
					elseif type(Item) == "string" then
						Selected[Item] = true
					end
				end
			elseif Value ~= nil then
				Selected[tostring(Value)] = true
			end
		else
			Single = tostring(Value or "")
		end
		Commit()
	end

	function Dropdown:SetOptions(NewOptions)
		Options = type(NewOptions) == "table" and NewOptions or {}
		if not Multi and not table.find(Options, Single) then
			Single = Options[1] and tostring(Options[1]) or ""
		end
		ClosePopup()
		Render()
	end

	local function Open()
		local Searchable = Opts.Search == true
		local RowHeight = 18
		local Shown = math.clamp(#Options, 1, 10)
		local Top = Searchable and 25 or 3
		local Frame, Body = Box({
			Size = UDim2.fromOffset(Line.AbsoluteSize.X, Shown * RowHeight + Top + 7),
			Position = UDim2.fromOffset(OverlayPoint(Line).X, OverlayPoint(Outer).Y + Outer.AbsoluteSize.Y + 1),
			ZIndex = 50,
		}, Overlay)
		local Scroll = New("ScrollingFrame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(0, Top),
			Size = UDim2.new(1, 0, 1, -(Top + 3)),
			CanvasSize = UDim2.fromOffset(0, 0),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Theme.AccentB,
			ElasticBehavior = Enum.ElasticBehavior.Never,
		}, Body)
		New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, Scroll)

		local Items = {}
		local function Paint()
			for Name, Item in Items do
				local On = Multi and Selected[Name] or (not Multi and Single == Name)
				Item.TextColor3 = On and Theme.AccentB or Theme.Dim
				Item.TextStrokeTransparency = On and 0.2 or 0.65
			end
		end

		for Index, Option in Options do
			local Name = tostring(Option)
			local Item = New("TextButton", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				LayoutOrder = Index,
				Size = UDim2.new(1, 0, 0, RowHeight),
				FontFace = Library.Font,
				TextSize = Library.TextSize,
				TextColor3 = Theme.Dim,
				TextStrokeTransparency = 0.65,
				TextXAlignment = Enum.TextXAlignment.Center,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Text = Name,
				AutoButtonColor = false,
			}, Scroll)
			Items[Name] = Item
			Item.MouseEnter:Connect(function()
				local On = Multi and Selected[Name] or (not Multi and Single == Name)
				if not On then
					Item.TextColor3 = Theme.Text
				end
			end)
			Item.MouseLeave:Connect(Paint)
			Item.MouseButton1Click:Connect(function()
				if Multi then
					Selected[Name] = not Selected[Name] or nil
					Paint()
					Commit()
				else
					Single = Name
					Commit()
					ClosePopup()
				end
			end)
		end
		Paint()

		if Searchable then
			local _, SearchInner = Box({ Position = UDim2.fromOffset(2, 2), Size = UDim2.new(1, -4, 0, 20) }, Body, Theme.Background)
			local SearchBox = New("TextBox", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = UDim2.fromOffset(5, 0),
				Size = UDim2.new(1, -10, 1, 0),
				FontFace = Library.Font,
				TextSize = Library.TextSize,
				TextColor3 = Theme.Text,
				PlaceholderColor3 = Theme.Dim,
				PlaceholderText = "Search",
				TextStrokeTransparency = 0.65,
				TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false,
				Text = "",
			}, SearchInner)
			SearchBox:GetPropertyChangedSignal("Text"):Connect(function()
				local Query = string.lower(SearchBox.Text)
				for Name, Item in Items do
					Item.Visible = Query == "" or string.find(string.lower(Name), Query, 1, true) ~= nil
				end
				Scroll.CanvasPosition = Vector2.zero
			end)
		end

		PlusLabel.Text = "-"
		PlusStem.Visible = false

		OpenPopup({
			Frame = Frame,
			Owner = Line,
			Close = function()
				PlusLabel.Text = "+"
				PlusStem.Visible = true
				Frame:Destroy()
			end,
		})
	end

	Button.MouseButton1Click:Connect(function()
		if Library._Dismissed == Line then
			Library._Dismissed = nil
			return
		end
		if Library._Popup and Library._Popup.Owner == Line then
			ClosePopup()
		else
			Open()
		end
	end)

	Render()

	RegisterOption(Flag, {
		Save = Current,
		Load = function(Data)
			Dropdown:Set(Data)
		end,
	})

	return Dropdown
end

