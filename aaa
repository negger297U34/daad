			if type(Data) ~= "table" then
				return
			end
			ClosePopup()
			for Key, Current in Settings do
				if type(Data[Key]) == type(Current) then
					Settings[Key] = Data[Key]
				end
			end
			Sync()
			local Ok, Parsed = pcall(Color3.fromHex, tostring(Data.Hex))
			if Ok then
				Swatch:Set(Parsed, tonumber(Data.Alpha))
			end
		end,
