					Settings[Key .. "Speed"] = Speed
				end,
			})
		end

		Show(Page)

		OpenPopup({
			Frame = Frame,
			Owner = Outer,
			Close = function()
				PopupRefresh = nil
				Frame:Destroy()
			end,
		})
	end

	Button.MouseButton1Click:Connect(function()
		if Library._Dismissed == Outer then
			Library._Dismissed = nil
			return
		end
		if Library._Popup and Library._Popup.Owner == Outer then
			ClosePopup()
		else
			Open()
		end
	end)

	RegisterOption(Flag, {
		Save = function()
			return {
				Hex = Color:ToHex(),
				Alpha = Alpha,
				Rainbow = Settings.Rainbow,
				RainbowSpeed = Settings.RainbowSpeed,
				Transparency = Settings.Transparency,
				TransparencySpeed = Settings.TransparencySpeed,
				Shade = Settings.Shade,
				ShadeSpeed = Settings.ShadeSpeed,
