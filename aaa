local NotifyHolder = New("Frame", {
	AnchorPoint = Vector2.new(1, 1),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	Position = UDim2.new(1, -20, 1, -20),
	Size = UDim2.fromOffset(360, 400),
}, NotifyGui)
local NotifyLayout = New("UIListLayout", {
	SortOrder = Enum.SortOrder.LayoutOrder,
	VerticalAlignment = Enum.VerticalAlignment.Bottom,
	HorizontalAlignment = Enum.HorizontalAlignment.Right,
	Padding = UDim.new(0, 6),
}, NotifyHolder)

local NotifyCount = 0

function Library:SetNotifyPosition(Corner)
	local Top = string.find(Corner, "Top", 1, true) ~= nil
	local Left = string.find(Corner, "Left", 1, true) ~= nil
	NotifyHolder.AnchorPoint = Vector2.new(Left and 0 or 1, Top and 0 or 1)
	NotifyHolder.Position = UDim2.new(Left and 0 or 1, Left and 20 or -20, Top and 0 or 1, Top and 20 or -20)
	NotifyLayout.VerticalAlignment = Top and Enum.VerticalAlignment.Top or Enum.VerticalAlignment.Bottom
	NotifyLayout.HorizontalAlignment = Left and Enum.HorizontalAlignment.Left or Enum.HorizontalAlignment.Right
end

function Library:Notify(Message, Duration)
	NotifyCount += 1
	local Outer, Inner = Box({ Size = UDim2.fromOffset(200, 32), LayoutOrder = NotifyCount }, NotifyHolder, Theme.Background)
	local Line = New("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 2) }, Inner)
	AccentGradient(Line)
	local Label = Text({
		Position = UDim2.fromOffset(12, 2),
		Size = UDim2.new(1, -24, 1, -3),
		Text = tostring(Message),
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, Inner)
	Label.TextStrokeColor3 = StrokeColor()
	local function Fit()
		Outer.Size = UDim2.fromOffset(math.clamp(math.ceil(Label.TextBounds.X) + 30, 200, 360), 32)
	end
	Label:GetPropertyChangedSignal("TextBounds"):Connect(Fit)
	Fit()
	local Timer = New("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		BackgroundColor3 = Theme.AccentB,
		BorderSizePixel = 0,
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 1),
	}, Inner)
	Duration = tonumber(Duration) or 3
	TweenService:Create(Timer, TweenInfo.new(Duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 1) }):Play()
	task.delay(Duration, function()
		Outer:Destroy()
	end)
end

function Library:Watermark(Opts)
	if type(Opts) ~= "table" then
		Opts = { Text = Opts }
	end
	local Outer, Inner = Box({
		Position = Opts.Position or UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(60, 22),
	}, Overlay, Theme.Background)
	local Line = New("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1) }, Inner)
	AccentGradient(Line)
	local Label = Text({
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.fromOffset(0, 1),
		Size = UDim2.new(0, 0, 1, -1),
		Text = tostring(Opts.Text or Library.Name),
	}, Inner)
	New("UIPadding", { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 8) }, Label)
	local function Fit()
		Outer.Size = UDim2.fromOffset(Label.AbsoluteSize.X + 4, 22)
	end
	Label:GetPropertyChangedSignal("AbsoluteSize"):Connect(Fit)
	Fit()

	local Watermark = { Outer = Outer }

	function Watermark:SetText(NewText)
		Label.Text = tostring(NewText)
	end

	function Watermark:SetVisible(State)
		Outer.Visible = State == true
	end

	Library._Watermark = Watermark
	return Watermark
end

local function ConfigPath(Name)
	return Library.Directory .. "/Configs/" .. tostring(Name) .. ".json"
end

function Library:SaveConfig(Name)
	if not (writefile and isfolder and makefolder) then
		return false, "filesystem unavailable"
	end
	if tostring(Name or "") == "" then
		return false, "empty name"
	end
	local Data = {}
	for Flag, Entry in Library.Options do
		local Ok, Value = pcall(Entry.Save)
		if Ok and Value ~= nil then
			Data[Flag] = Value
		end
	end
	return pcall(function()
		if not isfolder(Library.Directory) then
			makefolder(Library.Directory)
		end
		if not isfolder(Library.Directory .. "/Configs") then
			makefolder(Library.Directory .. "/Configs")
		end
		writefile(ConfigPath(Name), HttpService:JSONEncode(Data))
	end)
end

function Library:LoadConfig(Name)
	if not (readfile and isfile) then
		return false, "filesystem unavailable"
	end
	local Path = ConfigPath(Name)
	if not isfile(Path) then
		return false, "config not found"
	end
	local Ok, Data = pcall(function()
		return HttpService:JSONDecode(readfile(Path))
	end)
	if not Ok or type(Data) ~= "table" then
		return false, "invalid config"
	end
	for Flag, Value in Data do
		local Entry = Library.Options[Flag]
		if Entry then
			pcall(Entry.Load, Value)
		end
	end
	return true
end

function Library:DeleteConfig(Name)
	if not (delfile and isfile) then
		return false, "filesystem unavailable"
	end
	local Path = ConfigPath(Name)
	if not isfile(Path) then
		return false, "config not found"
	end
	return pcall(delfile, Path)
end

function Library:Unload()
	if Library.Unloaded then
		return
	end
	Library.Unloaded = true
	ClosePopup()
	for _, Connection in Library.Connections do
		pcall(function()
			Connection:Disconnect()
		end)
	end
	table.clear(Library.Connections)
	table.clear(Library.Binds)
	Gui:Destroy()
	Overlay:Destroy()
	NotifyGui:Destroy()
end

pcall(function()
	if isfile and readfile and isfile(Library.Directory .. "/theme.txt") then
		local Saved = readfile(Library.Directory .. "/theme.txt")
		if Library.Themes[Saved] and Saved ~= Library.ThemeName then
			Library:SetTheme(Saved)
		end
	end
end)

return Library
