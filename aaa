local function Box(Props, Parent, Fill)
	local Outer = New("Frame", { BackgroundColor3 = Theme.Outline, BorderSizePixel = 0 })
	for Key, Value in Props do
		Outer[Key] = Value
	end
	local Middle = New("Frame", {
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
	}, Outer)
	local Inner = New("Frame", {
		BackgroundColor3 = Fill or Theme.Element,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
	}, Middle)
	if not Fill then
		New("UIGradient", { Color = SHADE, Rotation = 90 }, Inner)
	end
	Outer.Parent = Parent
	return Outer, Inner, Middle
end

