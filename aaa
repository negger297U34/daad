		end
		table.clear(TitleChars)
		TitleHolder = New("Frame", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(7, 3),
			Size = UDim2.new(1, -14, 0, 18),
		}, Body)
		New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder }, TitleHolder)
		local function Add(Source, Accent)
			for _, Code in utf8.codes(Source) do
				local Char = utf8.char(Code)
				local Blank = Char == " "
				local Label = Text({
					AutomaticSize = Blank and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
					LayoutOrder = #TitleChars + 1,
					Size = UDim2.fromOffset(Blank and 4 or 0, 18),
					Text = Blank and "" or Char,
					TextColor3 = Accent and Theme.AccentB or Theme.Text,
				}, TitleHolder)
				local Padding = New("UIPadding", { PaddingTop = UDim.new(0, 2), PaddingBottom = UDim.new(0, 2) }, Label)
				table.insert(TitleChars, { Label = Label, Padding = Padding, Accent = Accent })
			end
		end
		Add(tostring(Main), Suffix == nil)
		if Suffix ~= nil then
			Add(tostring(Suffix), true)
		end
	end

	if Opts.Title then
		BuildTitle(Opts.Title, Opts.Suffix)
		if Opts.Wave ~= false then
			function Window.Wave(Now)
				for Index, Entry in TitleChars do
					local Shift = math.floor(math.sin(Now * 4 - Index * 0.6) * 2 + 0.5)
					Entry.Padding.PaddingTop = UDim.new(0, 2 + Shift)
					Entry.Padding.PaddingBottom = UDim.new(0, 2 - Shift)
					if Entry.Accent then
						Entry.Label.TextColor3 = Theme.AccentB
					end
				end
			end
		end
	end

	local Handle = New("TextButton", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, Opts.Title and 22 or 10),
		Text = "",
		AutoButtonColor = false,
		ZIndex = 4,
	}, Body)

	Handle.InputBegan:Connect(function(Input)
		if not IsPress(Input) then
			return
		end
		local Start = Input.Position
		local Origin = Outer.Position
		BeginDrag(function(Moved)
			local Delta = Moved.Position - Start
			Outer.Position = UDim2.fromOffset(Origin.X.Offset + Delta.X, Origin.Y.Offset + Delta.Y)
		end)
	end)

	Outer.InputBegan:Connect(function(Input)
		if IsPress(Input) then
			WindowOrder += 1
			Outer.ZIndex = WindowOrder
		end
	end)

	function Window:SetVisible(State)
		Window.Visible = State == true
		Outer.Visible = Window.Visible
		if not Window.Visible then
			ClosePopup()
		end
		if Window.TopbarEntry then
			Window.TopbarEntry.Refresh()
		end
	end

	function Window:Toggle()
		Window:SetVisible(not Window.Visible)
	end

	function Window:SetTitle(NewTitle, NewSuffix)
		BuildTitle(NewTitle, NewSuffix)
	end

	Outer.Visible = Window.Visible

	if Opts.Icon then
		Window.TopbarEntry = AddTopbarButton(Opts.Icon, function()
			return Window.Visible
		end, function()
			Window:Toggle()
		end)
	end

	table.insert(Library.Windows, Window)
	return Window
end

Connect(RunService.RenderStepped, function()
	if not Library.Open then
		return
	end
	local Now = os.clock()
	for _, Window in Library.Windows do
		if Window.Wave and Window.Visible then
			Window.Wave(Now)
		end
	end
end)

local function AttachTabs(Window, Top)
	local Bar = New("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(8, Top),
		Size = UDim2.new(1, -16, 0, 21),
		ZIndex = 3,
	}, Window.Body)
	New("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }, Bar)

	local Holder = New("Frame", {
		BackgroundColor3 = Theme.Border,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(8, Top + 20),
		Size = UDim2.new(1, -16, 1, -(Top + 28)),
	}, Window.Body)
	local Pages = New("Frame", {
		BackgroundColor3 = Theme.Inner,
		BorderSizePixel = 0,
		Position = UDim2.fromOffset(1, 1),
		Size = UDim2.new(1, -2, 1, -2),
	}, Holder)

	function Window:Tab(NameOrOpts)
		local TabOpts = type(NameOrOpts) == "table" and NameOrOpts or { Name = NameOrOpts }
		local Tab = { Active = false }

		local Button = New("TextButton", {
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			Size = UDim2.fromOffset(48, 21),
			Text = "",
			AutoButtonColor = false,
			LayoutOrder = #Window.Tabs + 1,
		}, Bar)
		local Back = New("Frame", { BackgroundColor3 = Theme.Border, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false }, Button)
		New("Frame", {
			BackgroundColor3 = Theme.Inner,
			BorderSizePixel = 0,
			Position = UDim2.fromOffset(1, 1),
			Size = UDim2.new(1, -2, 1, -1),
		}, Back)
		local Accent = New("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), ZIndex = 2 }, Back)
		AccentGradient(Accent)
		local Label = Text({
			Size = UDim2.fromScale(1, 1),
			Text = tostring(TabOpts.Name or "tab"),
			TextColor3 = Theme.Dim,
			TextXAlignment = Enum.TextXAlignment.Center,
			ZIndex = 3,
		}, Button)
		local function FitButton()
			Button.Size = UDim2.fromOffset(math.max(math.ceil(Label.TextBounds.X) + 20, 28), 21)
		end
		Label:GetPropertyChangedSignal("TextBounds"):Connect(FitButton)
		FitButton()

		local Page = New("Frame", { BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false }, Pages)
		Tab.Page = Page

		local Columns = {}
		if not TabOpts.Raw then
			for Index = 1, 2 do
				local Column = New("ScrollingFrame", {
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					Position = Index == 1 and UDim2.fromOffset(9, 4) or UDim2.new(0.5, 4, 0, 4),
					Size = UDim2.new(0.5, -13, 1, -12),
					CanvasSize = UDim2.fromOffset(0, 0),
					AutomaticCanvasSize = Enum.AutomaticSize.Y,
					ScrollBarThickness = 0,
					ElasticBehavior = Enum.ElasticBehavior.Never,
					ClipsDescendants = true,
				}, Page)
				New("UIPadding", {
					PaddingTop = UDim.new(0, 10),
					PaddingBottom = UDim.new(0, 2),
					PaddingLeft = UDim.new(0, 1),
					PaddingRight = UDim.new(0, 1),
				}, Column)
				New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 14) }, Column)
				Columns[Index] = { Frame = Column, Sections = {} }
			end
		end

		local function FitColumn(Column)
			local Count = math.max(#Column.Sections, 1)
			local Height = math.max(math.floor((Column.Frame.AbsoluteSize.Y - 14 - (Count - 1) * 14) / Count), 0)
			for _, Entry in Column.Sections do
				local Constraint = Entry.Frame:FindFirstChildOfClass("UISizeConstraint")
				if not Constraint then
					Constraint = New("UISizeConstraint", {}, Entry.Frame)
				end
				Constraint.MinSize = Vector2.new(0, Height)
			end
		end

		function Tab:Section(SectionOpts)
			SectionOpts = type(SectionOpts) == "table" and SectionOpts or { Name = SectionOpts }
			local Column = Columns[string.lower(tostring(SectionOpts.Side or "left")) == "right" and 2 or 1]
			local Created = CreateSection(Column.Frame, SectionOpts.Name, false)
			Created.Frame.LayoutOrder = #Column.Sections + 1
			table.insert(Column.Sections, Created)
			FitColumn(Column)
			if not Column.Watching then
				Column.Watching = true
				Column.Frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
					FitColumn(Column)
				end)
			end
			return Created
		end

		function Tab:Host(Side)
			local Full = Side == "Full"
			return New("Frame", {
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				Position = Side == "Right" and UDim2.new(0.5, 4, 0, 14) or UDim2.fromOffset(9, 14),
				Size = Full and UDim2.new(1, -18, 1, -22) or UDim2.new(0.5, -13, 1, -22),
			}, Page)
		end

		function Tab:SetActive(State)
			Tab.Active = State
			Back.Visible = State
			Page.Visible = State
			Label.TextColor3 = State and Theme.Text or Theme.Dim
		end

		Button.MouseButton1Click:Connect(function()
			ClosePopup()
			for _, Other in Window.Tabs do
				Other:SetActive(Other == Tab)
			end
		end)
		Button.MouseEnter:Connect(function()
			if not Tab.Active then
				Label.TextColor3 = Theme.Text
			end
		end)
		Button.MouseLeave:Connect(function()
			if not Tab.Active then
				Label.TextColor3 = Theme.Dim
			end
		end)

		table.insert(Window.Tabs, Tab)
		Tab:SetActive(#Window.Tabs == 1)
		return Tab
	end
end

